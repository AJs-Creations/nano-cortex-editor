<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 compiles JavaScript at run time (MAP_JIT); the hardened runtime blocks that without this key. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- getUserMedia({ audio: true }): Chromium only reveals audio output names (the metronome's output list) after
       microphone access. Under the hardened runtime the microphone prompt never appears without this key. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
